{
  "name": "jiu-jitsu-management",
  "version": "1.0.0",
  "description": "Sistema de gerenciamento para academias de Jiu-Jitsu",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watchAll",
    "setup-test-db": "cross-env NODE_OPTIONS=--experimental-vm-modules node setup-test-db.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "jiu-jitsu",
    "academia",
    "gerenciamento"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "5.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "babel-jest": "^30.0.0-beta.3",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "jest-circus": "^30.0.0-beta.3",
    "nodemon": "^3.1.10",
    "prisma": "5.20.0",
    "supertest": "^7.1.1"
  }
}
