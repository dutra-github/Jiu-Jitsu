// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  password     String
  avatar       String?
  role         String    @default("aluno") // admin, professor, aluno
  refreshToken String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  perfil       Perfil?
}

model Perfil {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  telefone  String?
  endereco  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Aluno {
  id                Int                @id @default(autoincrement())
  matricula         String              @unique
  nome              String
  email             String              @unique
  cpf               String?             @unique
  dataNascimento    DateTime?
  telefone          String?
  endereco          String?
  ativo             Boolean             @default(true)
  faixa             String?
  grau              Int?                @default(0)
  dataInicio        DateTime?
  observacoes       String?             @db.Text
  saude             String?             @db.Text
  aulasDesdeUltGrad Int                 @default(0)
  planoId           Int?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  mensalidades      Mensalidade[]
  presencas         Presenca[]
  graduacoes        HistoricoGraduacao[]
  inscricoes        InscricaoAula[]
  plano             Plano?              @relation(fields: [planoId], references: [id])
}

model Plano {
  id          Int      @id @default(autoincrement())
  nome        String
  tipo        String   // mensal, trimestral, semestral, anual
  valor       Float
  descricao   String?
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  alunos      Aluno[]
}

model Mensalidade {
  id              Int       @id @default(autoincrement())
  alunoId         Int
  valor           Float
  dataVencimento  DateTime
  dataPagamento   DateTime?
  formaPagamento  String?
  metodoPagamento String?   // dinheiro, cartão, pix, etc.
  comprovante     String?   // link para comprovante
  status          String    @default("pendente") // pendente, pago, atrasado, cancelado
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  aluno           Aluno     @relation(fields: [alunoId], references: [id])
}

model Presenca {
  id        Int      @id @default(autoincrement())
  alunoId   Int
  aulaId    Int?
  data      DateTime
  presente  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  aluno     Aluno    @relation(fields: [alunoId], references: [id])
  aula      Aula?    @relation(fields: [aulaId], references: [id])
}

model HistoricoGraduacao {
  id              Int      @id @default(autoincrement())
  alunoId         Int
  faixaAnterior   String?
  grauAnterior    Int?     @default(0)
  faixaNova       String
  grauNovo        Int      @default(0)
  dataGraduacao   DateTime
  quantidadeAulas Int?
  professor       String?
  observacoes     String?
  fotos           String?  // URLs das fotos separadas por vírgula
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  aluno           Aluno    @relation(fields: [alunoId], references: [id])
}

model RequisitoGraduacao {
  id              Int      @id @default(autoincrement())
  faixa           String
  grau            Int      @default(0)
  proximaFaixa    String
  proximoGrau     Int      @default(0)
  aulasNecessarias Int
  tempoMinimo     Int?     // em meses
  descricao       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Professor {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  telefone  String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  aulas     Aula[]
}

model Aula {
  id          Int        @id @default(autoincrement())
  titulo      String
  descricao   String?
  professorId Int?
  diaSemana   Int        // 0=segunda, 1=terça, etc.
  horaInicio  String
  horaFim     String
  tipo        String     // Gi, No-Gi, Sparring, Open Mat
  nivel       String     // Iniciante, Intermediário, Avançado, Todos
  vagas       Int        @default(20)
  ativo       Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  professor   Professor? @relation(fields: [professorId], references: [id])
  presencas   Presenca[]
  inscricoes  InscricaoAula[]
}

model InscricaoAula {
  id        Int      @id @default(autoincrement())
  alunoId   Int
  aulaId    Int
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  aluno     Aluno    @relation(fields: [alunoId], references: [id])
  aula      Aula     @relation(fields: [aulaId], references: [id])
  
  @@unique([alunoId, aulaId])
}

model TipoAula {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  cor       String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ArteMarcial {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
